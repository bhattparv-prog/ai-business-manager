# Database connection (SQLite by default for ₹0 local setup)
DATABASE_URL="file:./dev.db"

# Session JWT Secret
JWT_SECRET="change-this-to-a-random-32-byte-hex-string-for-production"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Optional: Google Gemini AI API Key (Can also be entered in Settings UI)
GEMINI_API_KEY=""

# Optional: Web Push Notification VAPID Keys (Auto-generated or configure here)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@local.host"
